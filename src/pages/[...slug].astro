---
import type { CollectionEntry } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import SimplePostLayout from '@/layouts/SimplePostLayout.astro'
import WidePostLayout from '@/layouts/WidePostLayout.astro'
import { render } from 'astro:content'
import { getSortedFilteredPosts } from '@/utils/draft'

export async function getStaticPaths() {
  const posts = await getSortedFilteredPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post
  }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []

// Select layout based on frontmatter
const layoutType = post.data.layout || 'default'
const layouts = {
  default: PostLayout,
  simple: SimplePostLayout,
  wide: WidePostLayout
}
const Layout = layouts[layoutType] || PostLayout
---

<Layout {...post.data} readingTime={readingTime} toc={toc}>
  <Content />
</Layout>
